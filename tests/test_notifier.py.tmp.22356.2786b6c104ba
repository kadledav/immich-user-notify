from builders import M

from immich_user_notify.models import AssetsAddedEvent, MemberAddedEvent
from immich_user_notify.notifier import (
    build_messages,
    build_recipients,
    select_recipients,
)


def recips():
    owner = M("owner", "owner@x.com", "Owner")
    members = [M("alice", "alice@x.com", "Alice"), M("bob", "bob@x.com", "Bob")]
    return build_recipients(
        owner=owner, members=members, default_language="en", user_languages={}
    )


def assets_event(contributor_ids, count=1):
    return AssetsAddedEvent("assets_added", "album-1", "Trip", count, contributor_ids)


def member_event(member):
    return MemberAddedEvent("member_added", "album-1", "Trip", member)


# --- recipients --------------------------------------------------------------


def test_build_recipients_owner_and_members():
    assert {r.topic for r in recips()} == {"owner", "alice", "bob"}


def test_build_recipients_dedup_owner_also_member():
    owner = M("owner", "owner@x.com", "Owner")
    rs = build_recipients(owner=owner, members=[owner], default_language="en", user_languages={})
    assert len(rs) == 1


def test_build_recipients_drops_no_email():
    owner = M("owner", "owner@x.com", "Owner")
    rs = build_recipients(
        owner=owner, members=[M("x", None, "X")], default_language="en", user_languages={}
    )
    assert {r.topic for r in rs} == {"owner"}


def test_recipient_language_resolution():
    owner = M("owner", "owner@x.com", "Owner")
    rs = build_recipients(
        owner=owner,
        members=[M("a", "a@x.com", "A")],
        default_language="en",
        user_languages={"a@x.com": "cs"},
    )
    by_topic = {r.topic: r.lang for r in rs}
    assert by_topic["owner"] == "en"
    assert by_topic["a"] == "cs"


def test_topic_collision_keeps_first():
    owner = M("owner", "david.k@a.com", "D1")
    other = M("other", "david-k@b.com", "D2")  # both -> "david-k"
    rs = build_recipients(owner=owner, members=[other], default_language="en", user_languages={})
    assert len(rs) == 1
    assert rs[0].user_id == "owner"


# --- selection rule ----------------------------------------------------------


def test_single_contributor_excluded():
    out = select_recipients(assets_event(["alice"]), recips())
    assert {r.topic for r in out} == {"owner", "bob"}


def test_two_contributors_exclude_nobody():
    out = select_recipients(assets_event(["alice", "bob"], count=2), recips())
    assert {r.topic for r in out} == {"owner", "alice", "bob"}


def test_member_added_only_new_member():
    out = select_recipients(member_event(M("alice", "alice@x.com", "Alice")), recips())
    assert {r.topic for r in out} == {"alice"}


# --- messages ----------------------------------------------------------------


def test_message_single_contributor_en(translator):
    msgs = build_messages(
        assets_event(["alice"]),
        recips(),
        translator=translator,
        public_url="https://p.example.com",
        icon_url=None,
        contributor_names={"alice": "Alice"},
    )
    assert {m.topic for m in msgs} == {"owner", "bob"}
    m = msgs[0]
    assert m.title == "New photos"
    assert m.body == 'Alice added new photos to "Trip".'
    assert m.tags == ["camera_with_flash"]
    assert m.priority == 4
    assert m.click == "https://p.example.com/albums/album-1"


def test_message_multiple_contributors(translator):
    msgs = build_messages(
        assets_event(["alice", "bob"], count=3),
        recips(),
        translator=translator,
        public_url="https://p",
        icon_url=None,
        contributor_names={},
    )
    assert {m.topic for m in msgs} == {"owner", "alice", "bob"}
    assert all(m.body == 'More photos were added to "Trip".' for m in msgs)


def test_message_member_added(translator):
    msgs = build_messages(
        member_event(M("alice", "alice@x.com", "Alice")),
        recips(),
        translator=translator,
        public_url="https://p",
        icon_url=None,
        contributor_names={},
    )
    assert len(msgs) == 1
    assert msgs[0].topic == "alice"
    assert msgs[0].title == "Album shared with you"
    assert msgs[0].body == 'You have been added to "Trip".'
    assert msgs[0].tags == ["handshake"]


def test_message_per_recipient_language(translator):
    owner = M("owner", "owner@x.com", "Owner")
    rs = build_recipients(
        owner=owner,
        members=[M("alice", "alice@x.com", "Alice")],
        default_language="en",
        user_languages={"owner@x.com": "cs"},
    )
    # alice is the sole contributor -> excluded; only owner (cs) is notified.
    msgs = build_messages(
        assets_event(["alice"]),
        rs,
        translator=translator,
        public_url="https://p",
        icon_url=None,
        contributor_names={"alice": "Alice"},
    )
    assert len(msgs) == 1
    assert msgs[0].topic == "owner"
    assert msgs[0].title == "Nové fotky"
    assert msgs[0].body == "Alice přidal(a) nové fotky do alba „Trip“."


def test_contributor_name_fallback_someone(translator):
    msgs = build_messages(
        assets_event(["ghost"]),  # not a recipient, not in names
        recips(),
        translator=translator,
        public_url="https://p",
        icon_url=None,
        contributor_names={},
    )
    assert {m.topic for m in msgs} == {"owner", "alice", "bob"}
    assert all(m.body == 'Someone added new photos to "Trip".' for m in msgs)
