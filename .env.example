# immich-user-notify — example configuration. Copy to .env and fill in.
# See the README for full details on each setting.

TZ=UTC

# --- Immich -----------------------------------------------------------------
# API key with the `album.read` and `user.read` permissions
# (Immich -> Account Settings -> API Keys), from an account that can see every
# album you want monitored.
IMMICH_TOKEN=__your-immich-api-key__

# Internal URL the container uses to reach the Immich server (no trailing /api):
#   same Docker network as Immich -> http://immich_server:2283
#   reachable host/IP             -> http://192.168.1.10:2283
IMMICH_PRIVATE_URL=http://immich_server:2283

# Public Immich URL, used for the tap-to-open album links in notifications.
IMMICH_PUBLIC_URL=https://photos.example.com

# --- ntfy -------------------------------------------------------------------
# Publisher account this app uses to send notifications. Create it and allow it
# to publish to the per-user topics:
#   ntfy user add immich-notify
#   ntfy access immich-notify 'immich-*' wo
NTFY_PUBLISHER_USERNAME=immich-notify
NTFY_PUBLISHER_PASSWORD=__change-me__

# Public base URL of the bundled ntfy (used by the example compose).
NTFY_BASE_URL=http://localhost:8080

# --- Behaviour --------------------------------------------------------------
# How often to poll, in minutes.
PERIODIC_CHECK_INTERVAL_MINUTES=15

# Default notification language: en or cs.
DEFAULT_LANGUAGE=en

# Optional per-person language overrides, keyed by email.
#USER_LANGUAGES=jana@example.com=cs,david.k@example.com=en

# Optional notification icon (defaults to the Immich logo if unset).
#NTFY_ICON_URL=https://raw.githubusercontent.com/immich-app/immich/main/design/immich-logo.png

# Only used by the example compose: the external Docker network your Immich stack runs on.
#IMMICH_NETWORK=immich_default
